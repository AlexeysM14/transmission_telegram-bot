def load_install_settings() -> dict[str, str]:
    if not INSTALL_CONFIG_FILE.exists():
        return {}

    stat = INSTALL_CONFIG_FILE.stat()
    if os.geteuid() == 0 and (stat.st_uid != 0 or stat.st_mode & 0o022):
        raise RuntimeError(f"Unsafe ownership or permissions on {INSTALL_CONFIG_FILE}")

    values: dict[str, str] = {}
    for line in INSTALL_CONFIG_FILE.read_text(encoding="utf-8").splitlines():
        raw = line.strip()
        if not raw or raw.startswith("#") or "=" not in raw:
            continue
        key, value = raw.split("=", 1)
        values[key.strip()] = value.strip()
    return values


