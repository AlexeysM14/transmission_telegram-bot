def set_env_key(key: str, prompt: str, *, allow_empty_delete: bool = False) -> None:
    data = load_env()
    value = input(prompt).strip()
    if not value:
        if not allow_empty_delete:
            print("⚠️ Empty value, nothing changed")
            return
        if key in data:
            data.pop(key, None)
            save_env(data)
            print(f"✅ Removed {key} from {ENV_FILE}")
        else:
            print(f"⚠️ {key} is not set, nothing changed")
        return
    data[key] = value
    save_env(data)


def normalize_proxy_url_or_raise(raw_url: str, *, env_name: str) -> str:
    value = raw_url.strip()
    if any(character.isspace() for character in value):
        raise ValueError(f"{env_name}: proxy URL must not contain whitespace")
    try:
        parts = urlsplit(value)
        hostname = parts.hostname
        _ = parts.port
    except ValueError as exc:
        raise ValueError(f"{env_name}: invalid proxy URL ({exc})") from exc
    scheme = parts.scheme.lower()
    if not scheme or not parts.netloc or not hostname:
        raise ValueError(f"{env_name}: invalid proxy URL")

    if scheme == "mtproto":
        raise ValueError(
            f"{env_name}: MTProto proxies are not supported for Telegram Bot API; use http(s):// or socks5://"
        )

    if scheme not in SUPPORTED_PROXY_SCHEMES:
        supported = ", ".join(sorted(SUPPORTED_PROXY_SCHEMES))
        raise ValueError(f"{env_name}: unsupported proxy scheme '{scheme}', supported: {supported}")
    return value


def normalize_hysteria2_proxy_url_or_raise(raw_url: str) -> str:
    value = normalize_proxy_url_or_raise(raw_url, env_name="HYSTERIA2_SOCKS5_PROXY")
    if urlsplit(value).scheme.lower() not in SOCKS_PROXY_SCHEMES:
        raise ValueError("HYSTERIA2_SOCKS5_PROXY must use socks5:// or socks5h://")
    return value


def normalize_hysteria2_profile_uri_or_raise(raw_uri: str) -> str:
    value = raw_uri.strip()
    if not value or len(value) > 8192 or any(character.isspace() for character in value):
        raise ValueError("Invalid Hysteria 2 profile URI")
    try:
        parts = urlsplit(value)
        hostname = parts.hostname
        port = parts.port
    except ValueError as exc:
        raise ValueError("Invalid Hysteria 2 profile URI") from exc
    if parts.scheme.lower() not in {"hy2", "hysteria2", "hysteria2+realm"} or not parts.netloc or not hostname:
        raise ValueError("Profile must use hysteria2://, hy2:// or hysteria2+realm://")
    if port is not None and not 1 <= port <= 65535:
        raise ValueError("Invalid Hysteria 2 profile URI")
    return value


def normalize_hysteria2_subscription_url_or_raise(raw_url: str) -> str:
    value = raw_url.strip()
    if not value or len(value) > 8192 or any(character.isspace() for character in value):
        raise ValueError("Invalid Hysteria 2 subscription URL")
    try:
        parts = urlsplit(value)
        hostname = parts.hostname
        port = parts.port
    except ValueError as exc:
        raise ValueError("Invalid Hysteria 2 subscription URL") from exc
    if parts.scheme.lower() not in {"http", "https"} or not parts.netloc or not hostname or parts.fragment:
        raise ValueError("Subscription must use http:// or https:// and must not contain a fragment")
    if port is not None and not 1 <= port <= 65535:
        raise ValueError("Invalid Hysteria 2 subscription URL")
    return value


def extract_hysteria2_profile_from_subscription(payload: bytes) -> str:
    if len(payload) > HYSTERIA2_SUBSCRIPTION_MAX_BYTES:
        raise ValueError("Hysteria 2 subscription response is too large")
    try:
        text = payload.decode("utf-8-sig").strip()
    except UnicodeDecodeError as exc:
        raise ValueError("Hysteria 2 subscription is not valid UTF-8") from exc

    # Многие панели отдают список ссылок как Base64 без обязательного padding.
    candidates = [text]
    compact = "".join(text.split())
    if compact:
        with contextlib.suppress(ValueError, UnicodeDecodeError):
            padding = "=" * (-len(compact) % 4)
            candidates.append(base64.urlsafe_b64decode(compact + padding).decode("utf-8-sig"))
    for candidate in candidates:
        for line in candidate.splitlines():
            value = line.strip()
            if not value:
                continue
            with contextlib.suppress(ValueError):
                return normalize_hysteria2_profile_uri_or_raise(value)
    raise ValueError("Subscription does not contain a supported Hysteria 2 profile")


def fetch_hysteria2_subscription(subscription_url: str) -> str:
    url = normalize_hysteria2_subscription_url_or_raise(subscription_url)
    request = Request(url, headers={"Accept": "text/plain", "User-Agent": f"{SERVICE_NAME}/subscription"})
    opener = build_opener(ProxyHandler({}))
    try:
        with opener.open(request, timeout=20) as response:  # nosec B310 - URL scheme validated above
            if response.geturl() != url:
                normalize_hysteria2_subscription_url_or_raise(response.geturl())
            payload = response.read(HYSTERIA2_SUBSCRIPTION_MAX_BYTES + 1)
    except (HTTPError, URLError, TimeoutError, OSError) as exc:
        raise RuntimeError(f"Could not download Hysteria 2 subscription ({type(exc).__name__})") from exc
    return extract_hysteria2_profile_from_subscription(payload)


def find_hysteria2_executable() -> Path:
    for candidate in (Path("/usr/local/bin/hysteria"), Path("/usr/bin/hysteria")):
        if not candidate.exists():
            continue
        assert_secure_regular_file(candidate, label="Hysteria 2 executable")
        if not os.access(candidate, os.X_OK):
            raise RuntimeError(f"Hysteria 2 executable is not executable: {candidate}")
        return candidate.resolve(strict=True)
    raise RuntimeError(
        "Hysteria 2 executable is not installed. Install the official 'hysteria' binary first, then retry."
    )


def atomic_write_service_file(path: Path, payload: str, *, mode: int, gid: int) -> None:
    assert_secure_directory(path.parent, label=f"parent directory for {path.name}")
    fd, temp_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temp_path = Path(temp_name)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as temp_file:
            temp_file.write(payload)
            temp_file.flush()
            os.fsync(temp_file.fileno())
        os.chown(temp_path, 0, gid)
        os.chmod(temp_path, mode)
        os.replace(temp_path, path)
    except Exception:
        with contextlib.suppress(OSError):
            os.close(fd)
        with contextlib.suppress(FileNotFoundError):
            temp_path.unlink()
        raise


def write_hysteria2_client_config(profile_uri: str) -> None:
    try:
        gid = grp.getgrnam(SERVICE_GROUP).gr_gid
    except KeyError as exc:
        raise RuntimeError(f"Service group does not exist: {SERVICE_GROUP}") from exc
    config = {
        "server": normalize_hysteria2_profile_uri_or_raise(profile_uri),
        "lazy": True,
        "socks5": {"listen": HYSTERIA2_SOCKS5_LISTEN},
    }
    atomic_write_service_file(
        HYSTERIA2_CONFIG_FILE,
        json.dumps(config, ensure_ascii=False, indent=2) + "\n",
        mode=0o640,
        gid=gid,
    )


def write_hysteria2_unit(executable: Path) -> None:
    for identity_name, identity in (("SERVICE_USER", SERVICE_USER), ("SERVICE_GROUP", SERVICE_GROUP)):
        if re.fullmatch(r"[A-Za-z_][A-Za-z0-9_-]*\$?", identity) is None:
            raise RuntimeError(f"{identity_name} is not valid for a systemd unit")
    unit = f"""[Unit]
Description=Hysteria 2 client for Transmission Telegram Bot
Wants=network-online.target
After=network-online.target
Before={SERVICE_NAME}.service

[Service]
Type=simple
User={SERVICE_USER}
Group={SERVICE_GROUP}
Environment=HYSTERIA_LOG_LEVEL=warn
Environment=HYSTERIA_DISABLE_UPDATE_CHECK=1
ExecStart={executable} client -c {HYSTERIA2_CONFIG_FILE}
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
"""
    atomic_write_service_file(HYSTERIA2_UNIT_FILE, unit, mode=0o644, gid=0)


def write_hysteria2_subscription_units() -> None:
    service = f"""[Unit]
Description=Update Hysteria 2 subscription for Transmission Telegram Bot
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart={CLI_IMPL_PATH} hysteria2-refresh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={HYSTERIA2_CONFIG_FILE}
"""
    timer = """[Unit]
Description=Periodically update Hysteria 2 subscription

[Timer]
OnBootSec=2min
OnUnitActiveSec=15min
RandomizedDelaySec=2min
Persistent=true

[Install]
WantedBy=timers.target
"""
    atomic_write_service_file(HYSTERIA2_UPDATE_UNIT_FILE, service, mode=0o644, gid=0)
    atomic_write_service_file(HYSTERIA2_UPDATE_TIMER_FILE, timer, mode=0o644, gid=0)


def refresh_hysteria2_subscription() -> bool:
    require_root_for_update()
    if not HYSTERIA2_SUBSCRIPTION_FILE.exists():
        raise RuntimeError("Hysteria 2 subscription is not configured")
    subscription_url = HYSTERIA2_SUBSCRIPTION_FILE.read_text(encoding="utf-8").strip()
    profile = fetch_hysteria2_subscription(subscription_url)
    old_payload = HYSTERIA2_CONFIG_FILE.read_text(encoding="utf-8") if HYSTERIA2_CONFIG_FILE.exists() else None
    write_hysteria2_client_config(profile)
    changed = old_payload != HYSTERIA2_CONFIG_FILE.read_text(encoding="utf-8")
    if changed:
        run(["systemctl", "try-restart", HYSTERIA2_SERVICE_NAME])
    print("✅ Hysteria 2 subscription updated" if changed else "✅ Hysteria 2 subscription is unchanged")
    return changed


def configure_hysteria2_subscription(subscription_url: str) -> None:
    require_root_for_update()
    executable = find_hysteria2_executable()
    normalized_url = normalize_hysteria2_subscription_url_or_raise(subscription_url)
    profile = fetch_hysteria2_subscription(normalized_url)
    write_hysteria2_client_config(profile)
    write_hysteria2_unit(executable)
    write_hysteria2_subscription_units()
    atomic_write_service_file(HYSTERIA2_SUBSCRIPTION_FILE, normalized_url + "\n", mode=0o600, gid=0)

    data = load_env()
    data["HYSTERIA2_SOCKS5_PROXY"] = HYSTERIA2_SOCKS5_PROXY
    save_env(data)
    run(["systemctl", "daemon-reload"])
    run(["systemctl", "enable", "--now", HYSTERIA2_UPDATE_SERVICE_NAME + ".timer"])
    run(["systemctl", "enable", HYSTERIA2_SERVICE_NAME])
    run(["systemctl", "restart", HYSTERIA2_SERVICE_NAME])
    run(["systemctl", "try-restart", SERVICE_NAME])
    print(f"✅ Hysteria 2 subscription configured; local SOCKS5: {HYSTERIA2_SOCKS5_PROXY}")


def configure_hysteria2_profile(profile_uri: str) -> None:
    require_root_for_update()
    executable = find_hysteria2_executable()
    normalized_profile = normalize_hysteria2_profile_uri_or_raise(profile_uri)
    write_hysteria2_client_config(normalized_profile)
    write_hysteria2_unit(executable)
    if HYSTERIA2_UPDATE_TIMER_FILE.exists():
        run(["systemctl", "disable", "--now", HYSTERIA2_UPDATE_SERVICE_NAME + ".timer"], check=False)
    with contextlib.suppress(FileNotFoundError):
        HYSTERIA2_SUBSCRIPTION_FILE.unlink()
    for path in (HYSTERIA2_UPDATE_UNIT_FILE, HYSTERIA2_UPDATE_TIMER_FILE):
        with contextlib.suppress(FileNotFoundError):
            path.unlink()

    data = load_env()
    data["HYSTERIA2_SOCKS5_PROXY"] = HYSTERIA2_SOCKS5_PROXY
    save_env(data)

    run(["systemctl", "daemon-reload"])
    run(["systemctl", "enable", HYSTERIA2_SERVICE_NAME])
    run(["systemctl", "restart", HYSTERIA2_SERVICE_NAME])
    run(["systemctl", "try-restart", SERVICE_NAME])
    print(f"✅ Hysteria 2 profile configured; local SOCKS5: {HYSTERIA2_SOCKS5_PROXY}")


def disable_hysteria2_profile() -> None:
    require_root_for_update()
    if HYSTERIA2_UNIT_FILE.exists():
        run(["systemctl", "disable", "--now", HYSTERIA2_SERVICE_NAME], check=False)
    if HYSTERIA2_UPDATE_TIMER_FILE.exists():
        run(["systemctl", "disable", "--now", HYSTERIA2_UPDATE_SERVICE_NAME + ".timer"], check=False)

    data = load_env()
    data.pop("HYSTERIA2_SOCKS5_PROXY", None)
    save_env(data)

    for path in (
        HYSTERIA2_CONFIG_FILE,
        HYSTERIA2_UNIT_FILE,
        HYSTERIA2_SUBSCRIPTION_FILE,
        HYSTERIA2_UPDATE_UNIT_FILE,
        HYSTERIA2_UPDATE_TIMER_FILE,
    ):
        with contextlib.suppress(FileNotFoundError):
            path.unlink()
    run(["systemctl", "daemon-reload"])
    run(["systemctl", "try-restart", SERVICE_NAME])
    print("✅ Hysteria 2 client disabled and its saved profile removed.")


def resolve_telegram_proxy_urls(
    tg_proxy: Optional[str],
    tg_get_updates_proxy: Optional[str],
    hysteria2_socks5_proxy: Optional[str],
) -> tuple[Optional[str], Optional[str]]:
    return (
        tg_proxy or hysteria2_socks5_proxy,
        tg_get_updates_proxy or tg_proxy or hysteria2_socks5_proxy,
    )


def unset_env_key(key: str) -> None:
    data = load_env()
    if key in data:
        data.pop(key, None)
        save_env(data)
        print(f"✅ Removed {key} from {ENV_FILE}")
        return
    print(f"⚠️ {key} is not set, nothing changed")


def get_log_file_path() -> Path:
    env = load_env()
    raw = env.get("LOG_FILE", str(LOG_DIR / "bot-errors.log")).strip()
    path = Path(raw).expanduser()
    if not path.is_absolute():
        path = ROOT / path
    return path


def print_last_log_lines(*, lines: int = 10) -> None:
    log_file = get_log_file_path()
    if not log_file.exists():
        print(f"⚠️ Log file does not exist yet: {log_file}")
        return

    content = log_file.read_text(encoding="utf-8", errors="replace").splitlines()
    tail = content[-lines:]
    print(f"\n=== Last {len(tail)} lines of {log_file} ===")
    for row in tail:
        print(row)


def mask_proxy_url(raw_url: Optional[str]) -> str:
    if not raw_url:
        return "direct"

    try:
        parts = urlsplit(raw_url)
        _ = parts.port
    except ValueError:
        return "<invalid URL>"
    if not parts.scheme or not parts.netloc or not parts.hostname:
        return "<invalid URL>"

    safe_netloc = parts.netloc
    if "@" in safe_netloc:
        _, _, hostinfo = safe_netloc.rpartition("@")
        safe_netloc = f"***:***@{hostinfo}"
    return urlunsplit((parts.scheme, safe_netloc, parts.path, "", ""))


def format_bool(value: bool) -> str:
    return "yes" if value else "no"


def parse_bool_value(raw: Optional[str]) -> bool:
    return (raw or "").strip().lower() in {"1", "true", "yes", "on"}


def format_dt(value: float) -> str:
    return datetime.fromtimestamp(value, tz=timezone.utc).astimezone().strftime("%Y-%m-%d %H:%M:%S %Z")


def build_proxy_handler(proxy_url: Optional[str]) -> ProxyHandler:
    if not proxy_url:
        return ProxyHandler({})
    return ProxyHandler({"http": proxy_url, "https": proxy_url})


def open_url(
    url: str,
    *,
    proxy_url: Optional[str],
    timeout: float,
    headers: Optional[dict[str, str]] = None,
    data: bytes | None = None,
) -> bytes:
    opener = build_opener(build_proxy_handler(proxy_url))
    request = Request(url, data=data, headers=headers or {})
    with opener.open(request, timeout=timeout) as response:
        return response.read()


def parse_timeout(raw: str) -> float:
    try:
        timeout = float((raw or "10").strip())
    except ValueError:
        return 10.0
    return timeout if math.isfinite(timeout) and timeout > 0 else 10.0


def validate_http_url(raw_url: str, *, label: str) -> str:
    value = raw_url.strip()
    if any(character.isspace() for character in value):
        raise ValueError(f"{label}: URL must not contain whitespace")
    try:
        parts = urlsplit(value)
        hostname = parts.hostname
        _ = parts.port
    except ValueError as exc:
        raise ValueError(f"{label}: invalid URL ({exc})") from exc
    if parts.scheme.lower() not in {"http", "https"} or not parts.netloc or not hostname:
        raise ValueError(f"{label}: URL must use http:// or https:// and include a host")
    if parts.query or parts.fragment:
        raise ValueError(f"{label}: URL must not contain a query string or fragment")
    return value


def build_transmission_url(env: dict[str, str]) -> str:
    explicit = env.get("TR_URL", "").strip()
    if explicit:
        return explicit

    protocol = env.get("TR_PROTOCOL", "http").strip() or "http"
    host = env.get("TR_HOST", "127.0.0.1").strip() or "127.0.0.1"
    port = env.get("TR_PORT", "9091").strip() or "9091"
    path = env.get("TR_PATH", "/transmission/rpc").strip() or "/transmission/rpc"
    if not path.startswith("/"):
        path = f"/{path}"
    return f"{protocol}://{host}:{port}{path}"


def build_basic_auth(user: Optional[str], password: Optional[str]) -> Optional[str]:
    if not user:
        return None
    token = base64.b64encode(f"{user}:{password or ''}".encode("utf-8")).decode("ascii")
    return f"Basic {token}"


def check_transmission_rpc(env: dict[str, str]) -> tuple[bool, str]:  # noqa: C901
    try:
        url = validate_http_url(build_transmission_url(env), label="Transmission RPC")
    except ValueError as exc:
        return False, f"error: {exc}"
    timeout = parse_timeout(env.get("TR_TIMEOUT", "10"))
    headers = {"Content-Type": "application/json"}
    auth = build_basic_auth(env.get("TR_USER"), env.get("TR_PASS"))
    if auth:
        headers["Authorization"] = auth

    payload = json.dumps({"method": "session-stats"}).encode("utf-8")
    try:
        open_url(url, proxy_url=None, timeout=timeout, headers=headers, data=payload)
    except HTTPError as exc:
        if exc.code != 409:
            return False, f"error: HTTP {exc.code}"
        session_id = exc.headers.get("X-Transmission-Session-Id", "").strip()
        if not session_id:
            return False, "error: missing X-Transmission-Session-Id"
        headers["X-Transmission-Session-Id"] = session_id
        try:
            response = open_url(url, proxy_url=None, timeout=timeout, headers=headers, data=payload)
        except HTTPError as retry_exc:
            return False, f"error: HTTP {retry_exc.code}"
        except URLError as retry_exc:
            return False, f"error: {retry_exc.reason}"
    except URLError as exc:
        return False, f"error: {exc.reason}"
    except OSError as exc:
        return False, f"error: {exc}"
    else:
        return False, "error: unexpected response without session handshake"

    try:
        body = json.loads(response.decode("utf-8"))
        arguments = body.get("arguments", {})
        active = arguments.get("activeTorrentCount", 0)
        paused = arguments.get("pausedTorrentCount", 0)
        total = arguments.get("torrentCount", 0)
        down = arguments.get("downloadSpeed", 0)
        up = arguments.get("uploadSpeed", 0)
        return True, f"ok: torrents={total}, active={active}, paused={paused}, down={down} B/s, up={up} B/s"
    except (ValueError, TypeError, AttributeError) as exc:
        return False, f"error: invalid JSON response ({exc})"


def check_telegram_api_via_socks(
    token: str,
    *,
    proxy_url: str,
    timeout: float,
    label: str,
) -> tuple[bool, str]:
    venv_python = ROOT / ".venv" / "bin" / "python"
    if not venv_python.exists():
        return False, f"{label}: installed virtualenv is missing"

    try:
        assert_secure_regular_file(venv_python, label="virtualenv Python")
        proc = subprocess.run(  # nosec B603
            [str(venv_python), "-I", "-c", _SOCKS_TELEGRAM_CHECK_CODE],
            cwd=ROOT,
            input=json.dumps({"token": token, "proxy_url": proxy_url, "timeout": timeout}),
            capture_output=True,
            text=True,
            timeout=timeout + 5.0,
            env=sanitized_subprocess_env(),
            check=False,
        )
    except (OSError, RuntimeError, subprocess.TimeoutExpired) as exc:
        return False, f"{label}: {type(exc).__name__}: SOCKS health check failed"

    if proc.returncode != 0:
        return False, f"{label}: SOCKS health check exited with status {proc.returncode}"
    try:
        result = json.loads(proc.stdout)
    except (json.JSONDecodeError, TypeError):
        return False, f"{label}: SOCKS health check returned invalid output"
    if not isinstance(result, dict):
        return False, f"{label}: SOCKS health check returned invalid output"
    message = str(result.get("message", "unknown error"))
    return bool(result.get("ok")), f"{label}: {message}"


def check_telegram_api(token: str, *, proxy_url: Optional[str], timeout: float, label: str) -> tuple[bool, str]:
    if proxy_url:
        try:
            proxy_url = normalize_proxy_url_or_raise(proxy_url, env_name=label)
        except ValueError as exc:
            return False, str(exc)
        if urlsplit(proxy_url).scheme.lower() in SOCKS_PROXY_SCHEMES:
            return check_telegram_api_via_socks(token, proxy_url=proxy_url, timeout=timeout, label=label)

    target = f"{TELEGRAM_API_BASE}/bot{token}/getMe"
    try:
        body = open_url(target, proxy_url=proxy_url, timeout=timeout)
        payload = json.loads(body.decode("utf-8"))
    except HTTPError as exc:
        return False, f"{label}: HTTP {exc.code}"
    except URLError as exc:
        return False, f"{label}: {exc.reason}"
    except OSError as exc:
        return False, f"{label}: {exc}"
    except ValueError as exc:
        return False, f"{label}: invalid JSON ({exc})"

    if not payload.get("ok"):
        description = str(payload.get("description", "unknown error"))
        return False, f"{label}: API error: {description}"

    result = payload.get("result") or {}
    username = result.get("username") or "unknown"
    return True, f"{label}: ok (@{username})"


def check_tcp_target(raw_url: str, *, timeout: float, label: str) -> tuple[bool, str]:
    try:
        parts = urlsplit(raw_url)
        host = parts.hostname
        port = parts.port
    except ValueError as exc:
        return False, f"{label}: invalid URL ({exc})"
    if not host or port is None:
        return False, f"{label}: invalid URL"

    try:
        with socket.create_connection((host, port), timeout=timeout):
            return True, f"{label}: tcp ok ({host}:{port})"
    except OSError as exc:
        return False, f"{label}: tcp error: {exc}"


def print_status() -> int:  # noqa: C901
    env = load_env()
    timeout = parse_timeout(env.get("TR_TIMEOUT", "10"))
    tg_token = env.get("TG_TOKEN", "").strip()
    allowed_user_ids = env.get("ALLOWED_USER_IDS", "").strip()
    allow_all_users = parse_bool_value(env.get("ALLOW_ALL_USERS"))
    tg_proxy = env.get("TG_PROXY", "").strip() or None
    tg_updates_proxy = env.get("TG_GET_UPDATES_PROXY", "").strip() or None
    hysteria2_proxy_raw = env.get("HYSTERIA2_SOCKS5_PROXY", "").strip() or None
    hysteria2_error: Optional[str] = None
    try:
        hysteria2_proxy = normalize_hysteria2_proxy_url_or_raise(hysteria2_proxy_raw) if hysteria2_proxy_raw else None
    except ValueError as exc:
        hysteria2_proxy = None
        hysteria2_error = str(exc)
    effective_bot_proxy, effective_updates_proxy = resolve_telegram_proxy_urls(
        tg_proxy,
        tg_updates_proxy,
        hysteria2_proxy,
    )
    log_file = get_log_file_path()
    venv_python = ROOT / ".venv" / "bin" / "python"

    print("=== transmission3-bot status ===")
    print(f"root: {ROOT}")
    print(f"env file: {ENV_FILE} ({'present' if ENV_FILE.exists() else 'missing'})")
    print(f"venv python: {venv_python} ({'present' if venv_python.exists() else 'missing'})")
    print(f"log file: {log_file} ({'present' if log_file.exists() else 'missing'})")
    if log_file.exists():
        stat = log_file.stat()
        print(f"  size: {stat.st_size} bytes")
        print(f"  modified: {format_dt(stat.st_mtime)}")

    print("\n[configuration]")
    print(f"TG_TOKEN configured: {format_bool(bool(tg_token))}")
    print(f"ALLOWED_USER_IDS configured: {format_bool(bool(allowed_user_ids))}")
    print(f"ALLOW_ALL_USERS: {format_bool(allow_all_users)}")
    print(f"TG_PROXY: {mask_proxy_url(tg_proxy)}")
    print(f"TG_GET_UPDATES_PROXY: {mask_proxy_url(tg_updates_proxy)}")
    print(f"HYSTERIA2_SOCKS5_PROXY: {mask_proxy_url(hysteria2_proxy_raw)}")
    print(f"Hysteria 2 profile configured: {format_bool(HYSTERIA2_CONFIG_FILE.exists())}")
    print(f"effective bot proxy: {mask_proxy_url(effective_bot_proxy)}")
    print(f"effective getUpdates proxy: {mask_proxy_url(effective_updates_proxy)}")
    print(f"Transmission RPC URL: {mask_proxy_url(build_transmission_url(env))}")
    print(f"TR_TIMEOUT: {timeout:g}s")

    print("\n[systemd]")
    service_ok = True
    for field, command in (
        ("active", ["systemctl", "is-active", SERVICE_NAME]),
        ("enabled", ["systemctl", "is-enabled", SERVICE_NAME]),
    ):
        code, out, err = run_capture(command)
        value = out or err or f"exit {code}"
        print(f"{field}: {value}")
        if code != 0 and field == "active":
            service_ok = False

    if HYSTERIA2_CONFIG_FILE.exists():
        for field, command in (
            ("Hysteria 2 active", ["systemctl", "is-active", HYSTERIA2_SERVICE_NAME]),
            ("Hysteria 2 enabled", ["systemctl", "is-enabled", HYSTERIA2_SERVICE_NAME]),
        ):
            code, out, err = run_capture(command)
            value = out or err or f"exit {code}"
            print(f"{field}: {value}")
            if code != 0 and field == "Hysteria 2 active":
                service_ok = False

    code, out, err = run_capture(
        [
            "systemctl",
            "show",
            SERVICE_NAME,
            "--property=MainPID,ExecMainStatus,ExecMainStartTimestamp,FragmentPath",
        ]
    )
    if code == 0:
        for line in out.splitlines():
            if line:
                print(line)
    else:
        print(f"details: {err or out or f'exit {code}'}")
        service_ok = False

    print("\n[checks]")
    overall_ok = service_ok

    if hysteria2_error:
        print(f"Hysteria 2 configuration: error: {hysteria2_error}")
        overall_ok = False

    tr_ok, tr_message = check_transmission_rpc(env)
    print(f"Transmission RPC: {tr_message}")
    overall_ok = overall_ok and tr_ok

    if tg_proxy:
        tcp_ok, tcp_message = check_tcp_target(tg_proxy, timeout=timeout, label="TG_PROXY")
        print(f"Proxy socket: {tcp_message}")
        overall_ok = overall_ok and tcp_ok
    else:
        print("Proxy socket: TG_PROXY not configured")

    if tg_updates_proxy and tg_updates_proxy != tg_proxy:
        upd_tcp_ok, upd_tcp_message = check_tcp_target(tg_updates_proxy, timeout=timeout, label="TG_GET_UPDATES_PROXY")
        print(f"Updates proxy socket: {upd_tcp_message}")
        overall_ok = overall_ok and upd_tcp_ok

    if hysteria2_proxy and hysteria2_proxy not in {tg_proxy, tg_updates_proxy}:
        hy2_tcp_ok, hy2_tcp_message = check_tcp_target(
            hysteria2_proxy,
            timeout=timeout,
            label="Hysteria 2 SOCKS5",
        )
        print(f"Hysteria 2 socket: {hy2_tcp_message}")
        overall_ok = overall_ok and hy2_tcp_ok

    if not effective_bot_proxy and not effective_updates_proxy:
        print("Telegram transport: direct connection")

    if tg_token:
        bot_ok, bot_message = check_telegram_api(
            tg_token,
            proxy_url=effective_bot_proxy,
            timeout=timeout,
            label="Telegram Bot API",
        )
        print(bot_message)
        overall_ok = overall_ok and bot_ok

        if effective_updates_proxy != effective_bot_proxy:
            upd_ok, upd_message = check_telegram_api(
                tg_token,
                proxy_url=effective_updates_proxy,
                timeout=timeout,
                label="Telegram getUpdates path",
            )
            print(upd_message)
            overall_ok = overall_ok and upd_ok
    else:
        print("Telegram Bot API: skipped (TG_TOKEN is not configured)")

    print("\n[result]")
    print("overall status: OK" if overall_ok else "overall status: NEEDS ATTENTION")
    return 0 if overall_ok else 1


def menu() -> None:  # noqa: C901
    while True:
        print(
            "\n=== transmission3-bot update ===\n"
            "1) Download updates from GitHub and restart bot service\n"
            "2) Set Telegram bot token (TG_TOKEN)\n"
            "3) Set Telegram allowed user id(s) (ALLOWED_USER_IDS)\n"
            "4) Set Telegram proxy URL (TG_PROXY, example: http://login:password@127.0.0.1:8080)\n"
            "5) Set Telegram getUpdates proxy URL (TG_GET_UPDATES_PROXY, optional)\n"
            "6) Set Transmission RPC URL (TR_URL, example: http://127.0.0.1:9091/transmission/rpc)\n"
            "7) Restart bot service\n"
            "8) Show last 10 lines from bot error log (показать последние 10 строк логов)\n"
            "9) Disable Telegram proxy (remove TG_PROXY)\n"
            "10) Disable Telegram getUpdates proxy override (remove TG_GET_UPDATES_PROXY)\n"
            "11) Allow every private Telegram user (set ALLOW_ALL_USERS=1)\n"
            "12) Disable allow-all access (remove ALLOW_ALL_USERS)\n"
            "13) Add Hysteria 2 profile URI and configure the local client\n"
            "14) Disable Hysteria 2 and remove its saved profile\n"
            "15) Add Hysteria 2 subscription URL with automatic updates\n"
            "0) Exit\n"
        )

        choice = input("Select an action: ").strip()

        try:
            if choice == "1":
                do_update_from_github()
            elif choice == "2":
                data = load_env()
                value = getpass.getpass("Enter Telegram token: ").strip()
                if not value:
                    print("⚠️ Empty value, nothing changed")
                else:
                    data["TG_TOKEN"] = value
                    save_env(data)
            elif choice == "3":
                set_env_key(
                    "ALLOWED_USER_IDS",
                    "Enter user id(s), comma-separated (empty denies everyone unless ALLOW_ALL_USERS=1): ",
                    allow_empty_delete=True,
                )
            elif choice == "4":
                data = load_env()
                value = getpass.getpass(
                    "Enter Telegram proxy URL (leave empty to disable proxy; supported: http(s):// or socks5://): "
                ).strip()
                if not value:
                    data.pop("TG_PROXY", None)
                    save_env(data)
                    print(f"✅ Removed TG_PROXY from {ENV_FILE}")
                else:
                    data["TG_PROXY"] = normalize_proxy_url_or_raise(value, env_name="TG_PROXY")
                    save_env(data)
            elif choice == "5":
                data = load_env()
                value = getpass.getpass(
                    "Enter Telegram getUpdates proxy URL "
                    "(leave empty to reuse TG_PROXY; supported: http(s):// or socks5://): "
                ).strip()
                if not value:
                    data.pop("TG_GET_UPDATES_PROXY", None)
                    save_env(data)
                    print(f"✅ Removed TG_GET_UPDATES_PROXY from {ENV_FILE}")
                else:
                    data["TG_GET_UPDATES_PROXY"] = normalize_proxy_url_or_raise(value, env_name="TG_GET_UPDATES_PROXY")
                    save_env(data)
            elif choice == "6":
                data = load_env()
                value = getpass.getpass(
                    "Enter Transmission RPC URL (leave empty to use TR_PROTOCOL/TR_HOST/TR_PORT/TR_PATH): "
                ).strip()
                if not value:
                    data.pop("TR_URL", None)
                else:
                    data["TR_URL"] = validate_http_url(value, label="TR_URL")
                save_env(data)
            elif choice == "7":
                restart_bot_service()
            elif choice == "8":
                print_last_log_lines(lines=10)
            elif choice == "9":
                unset_env_key("TG_PROXY")
            elif choice == "10":
                unset_env_key("TG_GET_UPDATES_PROXY")
            elif choice == "11":
                data = load_env()
                data["ALLOW_ALL_USERS"] = "1"
                save_env(data)
            elif choice == "12":
                unset_env_key("ALLOW_ALL_USERS")
            elif choice == "13":
                value = getpass.getpass(
                    "Paste Hysteria 2 profile (hysteria2://, hy2:// or hysteria2+realm://): "
                ).strip()
                if not value:
                    print("⚠️ Empty profile, nothing changed")
                else:
                    configure_hysteria2_profile(value)
            elif choice == "14":
                disable_hysteria2_profile()
            elif choice == "15":
                value = getpass.getpass("Paste Hysteria 2 subscription URL (http:// or https://): ").strip()
                if not value:
                    print("⚠️ Empty subscription URL, nothing changed")
                else:
                    configure_hysteria2_subscription(value)
            elif choice == "0":
                print("Bye")
                return
            else:
                print("❌ Unknown item")
        except Exception as exc:
            print(f"❌ {exc}")


def main() -> int:
    if len(sys.argv) == 2 and sys.argv[1] == "hysteria2-refresh":
        refresh_hysteria2_subscription()
        return 0
    if len(sys.argv) == 2 and sys.argv[1] == "update":
        require_root_for_update()
        menu()
        return 0
    if len(sys.argv) == 2 and sys.argv[1] == "status":
        return print_status()

    print("Usage: transmission3-bot update|status")
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
