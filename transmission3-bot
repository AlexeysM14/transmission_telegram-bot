def sanitized_subprocess_env() -> dict[str, str]:
    env = os.environ.copy()
    for key in tuple(env):
        if key.startswith(
            (
                "PYTHON",
                "PIP_",
                "GIT_",
                "LD_",
                "DYLD_",
                "APT_",
                "DPKG_",
                "CARGO_",
            )
        ) or key in {
            "ALL_PROXY",
            "BASH_ENV",
            "BASHOPTS",
            "CDPATH",
            "CURL_CA_BUNDLE",
            "ENV",
            "GLOBIGNORE",
            "HTTP_PROXY",
            "HTTPS_PROXY",
            "IFS",
            "MAKEFLAGS",
            "NO_PROXY",
            "REQUESTS_CA_BUNDLE",
            "RUSTC_WRAPPER",
            "SHELLOPTS",
            "SSL_CERT_DIR",
            "SSL_CERT_FILE",
            "SSLKEYLOGFILE",
            "all_proxy",
            "http_proxy",
            "https_proxy",
            "no_proxy",
        }:
            env.pop(key, None)
    env["PATH"] = "/usr/sbin:/usr/bin:/sbin:/bin"
    env["PYTHONNOUSERSITE"] = "1"
    env["PYTHONSAFEPATH"] = "1"
    env["PIP_CONFIG_FILE"] = "/dev/null"
    return env


def run(
    cmd: list[str],
    *,
    check: bool = True,
    env: Optional[dict[str, str]] = None,
    cwd: Optional[Path] = None,
    display_cmd: Optional[list[str]] = None,
) -> int:
    safe_cmd = display_cmd or cmd
    print(f"\n$ {' '.join(safe_cmd)}")
    proc = subprocess.run(  # nosec B603
        cmd,
        cwd=cwd or ROOT,
        env=env or sanitized_subprocess_env(),
    )
    if check and proc.returncode != 0:
        raise RuntimeError(f"Command failed: {' '.join(safe_cmd)}")
    return proc.returncode


def run_capture(cmd: list[str]) -> tuple[int, str, str]:
    proc = subprocess.run(  # nosec B603
        cmd,
        cwd=ROOT,
        capture_output=True,
        text=True,
        env=sanitized_subprocess_env(),
    )
    return proc.returncode, proc.stdout.strip(), proc.stderr.strip()


def load_env() -> dict[str, str]:
    data: dict[str, str] = {}
    if not ENV_FILE.exists():
        return data

    try:
        lines = ENV_FILE.read_text(encoding="utf-8").splitlines()
    except PermissionError as exc:
        raise PermissionError(f"Cannot read {ENV_FILE}; run this command as root") from exc

    for line in lines:
        raw = line.strip()
        if not raw or raw.startswith("#") or "=" not in raw:
            continue
        key, value = raw.split("=", 1)
        data[key.strip()] = value.strip().strip('"').strip("'")
    return data


def save_env(values: dict[str, str]) -> None:
    lines = [
        "# telegram bot settings",
        *(f"{k}={v}" for k, v in sorted(values.items())),
        "",
    ]
    payload = "\n".join(lines)
    tmp_path = ENV_FILE.with_name(f".{ENV_FILE.name}.tmp")

    try:
        fd = os.open(tmp_path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as temp_file:
            temp_file.write(payload)
            temp_file.flush()
            os.fsync(temp_file.fileno())

        os.replace(tmp_path, ENV_FILE)
        secure_env_file()
    except Exception:
        with contextlib.suppress(FileNotFoundError):
            tmp_path.unlink()
        raise

    print(f"✅ Saved {ENV_FILE}")


def secure_env_file() -> None:
    if not ENV_FILE.exists():
        return

    if os.geteuid() != 0:
        raise PermissionError(f"Run this command with sudo to secure {ENV_FILE}")

    try:
        gid = grp.getgrnam(SERVICE_GROUP).gr_gid
    except KeyError as exc:
        raise RuntimeError(f"Service group does not exist: {SERVICE_GROUP}") from exc

    os.chown(ENV_FILE, 0, gid)
    os.chmod(ENV_FILE, 0o640)


def require_root_for_update() -> None:
    if os.geteuid() != 0:
        raise PermissionError("Code and configuration updates require sudo")


def assert_secure_regular_file(path: Path, *, label: str) -> None:
    resolved = path.resolve(strict=True)
    stat = resolved.stat()
    if not resolved.is_file():
        raise RuntimeError(f"{label} is not a regular file: {resolved}")
    if stat.st_uid != 0 or stat.st_mode & 0o022:
        raise RuntimeError(f"Refusing to use service-writable {label}: {resolved}")


def assert_secure_directory(path: Path, *, label: str) -> None:
    resolved = path.resolve(strict=True)
    stat = resolved.stat()
    if not resolved.is_dir():
        raise RuntimeError(f"{label} is not a directory: {resolved}")
    if stat.st_uid != 0 or stat.st_mode & 0o022:
        raise RuntimeError(f"Refusing to use service-writable {label}: {resolved}")


def trusted_system_executable(name: str) -> str:
    executable = shutil.which(name, path="/usr/sbin:/usr/bin:/sbin:/bin")
    if not executable:
        raise RuntimeError(f"Required system executable was not found: {name}")
    assert_secure_regular_file(Path(executable), label=name)
    return executable


def git_env() -> dict[str, str]:
    env = sanitized_subprocess_env()
    for key in tuple(env):
        if key.startswith("GIT_"):
            env.pop(key)
    env.update(
        {
            "GIT_CONFIG_NOSYSTEM": "1",
            "GIT_CONFIG_GLOBAL": "/dev/null",
            "GIT_CONFIG": "/dev/null",
        }
    )
    return env


def run_clean_git_clone(destination: Path) -> None:
    git = trusted_system_executable("git")
    run(
        [
            git,
            "-c",
            "core.hooksPath=/dev/null",
            "-c",
            "core.fsmonitor=false",
            "-c",
            "protocol.ext.allow=never",
            "clone",
            "--quiet",
            "--depth",
            "1",
            "--no-hardlinks",
            "--",
            REPO_URL,
            str(destination),
        ],
        env=git_env(),
        cwd=destination.parent,
        display_cmd=[git, "clone", "<configured repository>", str(destination)],
    )


def resolve_checkout_commit(checkout: Path) -> str:
    git = trusted_system_executable("git")
    proc = subprocess.run(  # nosec B603
        [
            git,
            "-c",
            "core.hooksPath=/dev/null",
            "-c",
            "core.fsmonitor=false",
            "-c",
            "protocol.ext.allow=never",
            "-C",
            str(checkout),
            "rev-parse",
            "--verify",
            "HEAD^{commit}",
        ],
        capture_output=True,
        text=True,
        env=git_env(),
        check=False,
    )
    commit = proc.stdout.strip().lower()
    if proc.returncode != 0 or re.fullmatch(r"(?:[0-9a-f]{40}|[0-9a-f]{64})", commit) is None:
        raise RuntimeError("Unable to resolve the clean checkout commit")
    return commit


def assert_secure_tree(root: Path) -> None:
    for directory, dir_names, file_names in os.walk(root, followlinks=False):
        paths = [Path(directory), *(Path(directory) / name for name in dir_names + file_names)]
        for path in paths:
            stat = path.lstat()
            if stat.st_uid != 0 or (not path.is_symlink() and stat.st_mode & 0o022):
                raise RuntimeError(f"Refusing to use service-writable path: {path}")


def do_update_from_github() -> None:
    require_root_for_update()
    install_parent = ROOT.parent.resolve(strict=True)
    assert_secure_directory(install_parent, label="installation parent")
    bootstrap_root = Path(tempfile.mkdtemp(prefix=f".{SERVICE_NAME}.updater-", dir=install_parent))
    clean_checkout = bootstrap_root / "checkout"
    try:
        run_clean_git_clone(clean_checkout)
        assert_secure_tree(clean_checkout)
        expected_commit = resolve_checkout_commit(clean_checkout)
        installer = clean_checkout / "install.sh"
        assert_secure_regular_file(installer, label="clean installer")
        bash = trusted_system_executable("bash")
        deploy_env = sanitized_subprocess_env()
        deploy_env.update(
            {
                "INSTALL_DIR": str(ROOT),
                "SERVICE_USER": SERVICE_USER,
                "SERVICE_GROUP": SERVICE_GROUP,
                "REPO_URL": REPO_URL,
                "EXPECTED_COMMIT": expected_commit,
                "START_SERVICE": "1",
            }
        )
        run([bash, str(installer)], env=deploy_env, cwd=clean_checkout)
    finally:
        shutil.rmtree(bootstrap_root, ignore_errors=True)

    print("✅ Clean release installed and service health check passed.")


